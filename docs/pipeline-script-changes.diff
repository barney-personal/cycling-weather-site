+def _attach_slugs(latest: Optional[dict]) -> Optional[dict]:
+    """Return a copy of `latest` with a `slug` field on each result row.
+
+    Slug is derived from the destination name; stable across runs."""
+    if not latest:
+        return latest
+    results = latest.get("results") or []
+    new_results = []
+    for r in results:
+        rr = dict(r)
+        rr["slug"] = slugify(rr.get("name") or "")
+        new_results.append(rr)
+    out = dict(latest)
+    out["results"] = new_results
+    return out
+
