+def _ranked(results: List[dict]) -> List[dict]:
+    """Return results sorted by score desc — the canonical homepage ranking."""
+    return sorted(
+        [r for r in results if r and r.get("name")],
+        key=lambda r: (r.get("score") or 0),
+        reverse=True,
+    )
+
+
+def _editorial(latest: dict, top: dict, go_count: int) -> str:
+    """One-to-two sentence hero copy describing today's overall verdict.
+
+    Pure template — no LLM. Falls back gracefully when fields are missing."""
+    name = top.get("name") or "the leader"
+    best_run = top.get("best_run") or 0
+    median = top.get("median_temp")
+    median_s = f"{median:.0f}°C" if isinstance(median, (int, float)) else "—"
+    if go_count >= 3:
+        return (
+            f"{go_count} destinations are flirting with a clean 7-day window — "
+            f"{name} leads at {median_s}."
+        )
+    if go_count == 1:
+        return (
+            f"{name} is the only destination clearing the bar this fortnight — "
+            f"a {best_run}-day clean run, median {median_s}."
+        )
+    if best_run >= 4:
+        return (
+            f"No clean 7-day window anywhere — {name} comes closest with "
+            f"{best_run} contiguous days at {median_s}."
+        )
+    return (
+        f"Nowhere is properly rideable yet. {name} tops the table at {median_s}, "
+        "but no destination strings 7 clean days together."
+    )
+
