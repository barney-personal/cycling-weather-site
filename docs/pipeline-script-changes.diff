+def build_hero(latest: Optional[dict]) -> Optional[dict]:
+    """Hero block: top destination + lead window + GO count + editorial copy."""
+    if not latest:
+        return None
+    results = _ranked(latest.get("results") or [])
+    if not results:
+        return None
+    top = results[0]
+    go_count = sum(1 for r in results if r.get("qualifier"))
+    if go_count >= 3:
+        verdict = "go"
+    elif go_count >= 1:
+        verdict = "edge"
+    else:
+        verdict = "no-go"
+    return {
+        "verdict": verdict,
+        "top_slug": slugify(top.get("name") or ""),
+        "top_name": top.get("name"),
+        "top_region": top.get("region"),
+        "top_score": top.get("score"),
+        "top_median_temp": top.get("median_temp"),
+        "top_best_run": top.get("best_run"),
+        "lead_window_start": top.get("best_start"),
+        "lead_window_end": top.get("best_end"),
+        "go_count": go_count,
+        "total_count": len(results),
+        "editorial": _editorial(latest, top, go_count),
+        "outlook": latest.get("outlook"),
+        "forecast_date": latest.get("forecast_date"),
+    }
+
+
+def build_changelog(forecasts: List[dict]) -> List[dict]:
+    """Per-destination changes from the previous snapshot to the latest one.
+
+    Each entry: { name, slug, region, rank_now, rank_prev, rank_delta,
+    qualifier_now, qualifier_prev, qualifier_flip }. With <2 snapshots,
+    deltas are null and qualifier_flip is false."""
+    if not forecasts:
+        return []
+    latest = forecasts[-1]
+    prev = forecasts[-2] if len(forecasts) >= 2 else None
+    latest_ranked = _ranked(latest.get("results") or [])
+    rank_by_name_now: Dict[str, int] = {
+        (r.get("name") or ""): i + 1 for i, r in enumerate(latest_ranked)
+    }
+    rank_by_name_prev: Dict[str, int] = {}
+    qualifier_prev_by_name: Dict[str, bool] = {}
+    if prev:
+        prev_ranked = _ranked(prev.get("results") or [])
+        rank_by_name_prev = {
+            (r.get("name") or ""): i + 1 for i, r in enumerate(prev_ranked)
+        }
+        qualifier_prev_by_name = {
+            (r.get("name") or ""): bool(r.get("qualifier"))
+            for r in prev_ranked
+        }
+    out = []
+    for r in latest_ranked:
+        name = r.get("name") or ""
+        rank_now = rank_by_name_now.get(name)
+        rank_prev = rank_by_name_prev.get(name) if prev else None
+        rank_delta = (rank_prev - rank_now) if (rank_prev is not None and rank_now is not None) else None
+        qualifier_now = bool(r.get("qualifier"))
+        qualifier_prev = qualifier_prev_by_name.get(name) if prev else None
+        qualifier_flip = (
+            qualifier_prev is not None and qualifier_prev != qualifier_now
+        )
+        out.append({
+            "name": name,
+            "slug": slugify(name),
+            "region": r.get("region"),
+            "rank_now": rank_now,
+            "rank_prev": rank_prev,
+            "rank_delta": rank_delta,
+            "qualifier_now": qualifier_now,
+            "qualifier_prev": qualifier_prev,
+            "qualifier_flip": qualifier_flip,
+        })
+    return out
+
