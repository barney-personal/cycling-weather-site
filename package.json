{
  "name": "cycling-weather-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daily cycling weather forecast site — flagship build (Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw-precache.mjs",
    "build:sw-precache": "node scripts/build-sw-precache.mjs",
    "build:brand": "node scripts/generate-brand.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning tests/data-loader.spec.ts tests/qualify.spec.ts",
    "test:loader": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning tests/data-loader.spec.ts",
    "test:qualify": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning tests/qualify.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@biomejs/biome": "1.9.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-fetch": "^3.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "playwright": "^1.59.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-fetch": "^3.0.1",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
