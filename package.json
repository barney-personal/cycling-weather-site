{
  "name": "cycling-weather-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Daily cycling weather forecast site — flagship build (Vite + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "npm run typecheck && npm run lint",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
